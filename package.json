{
  "name": "yuzhi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/write-build-revision.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "dev:worker": "npm run build && wrangler dev"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
